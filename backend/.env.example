# Application
APP_NAME=SignLink AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# Database
DATABASE_URL=postgresql+asyncpg://signlink:signlink123@localhost:5432/signlink_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ML Inference Server
ML_INFERENCE_URL=http://localhost:8001
ML_INFERENCE_TIMEOUT=30
ML_BATCH_SIZE=8
ML_MAX_QUEUE_SIZE=100

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=signlink-ai-models
S3_MODELS_PREFIX=models/
S3_MEDIA_PREFIX=media/

# Stripe Billing
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_BASIC=price_basic
STRIPE_PRICE_ID_PRO=price_pro
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@signlink.ai
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@signlink.ai
SMTP_FROM_NAME=SignLink AI

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
SENTRY_DSN=

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_BILLING=true
ENABLE_ADMIN_API=true
ENABLE_METRICS=true

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXIES=
MAX_UPLOAD_SIZE_MB=10
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Multi-tenancy
MULTI_TENANT_ENABLED=true
DEFAULT_TENANT_ID=default

# WebSocket
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10
WEBSOCKET_MAX_CONNECTIONS=1000
